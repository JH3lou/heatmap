{
  "name": "@jh3lou/account-heatmap",
  "version": "0.1.0",
  "description": "Interactive, filterable stacked-bar heatmap component for React — drop it next to any data table for click-to-filter category visualizations.",
  "author": "Justin Helou <justinhelou96@gmail.com> (https://github.com/JH3lou)",
  "license": "MIT",
  "homepage": "https://github.com/JH3lou/heatmap/tree/main/packages/heatmap-react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JH3lou/heatmap.git",
    "directory": "packages/heatmap-react"
  },
  "bugs": {
    "url": "https://github.com/JH3lou/heatmap/issues"
  },
  "keywords": [
    "react",
    "heatmap",
    "visualization",
    "stacked-bar",
    "filter",
    "data-table",
    "dashboard",
    "tailwind"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build:js": "tsup",
    "build:css": "tailwindcss -i ./src/styles.css -o ./dist/styles.css --minify",
    "build": "npm run clean && npm run build:js && npm run build:css",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.17",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
